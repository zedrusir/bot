# ── Telegram ──────────────────────────────────────────────────
BOT_TOKEN=your_bot_token_here

# Comma-separated list of admin Telegram user IDs
ADMIN_IDS=1633424988

# ── Google Drive ───────────────────────────────────────────────
# ID of the root Drive folder (everything goes inside here)
DRIVE_FOLDER_ID=your_google_drive_folder_id_here

# Path to your downloaded Service Account JSON key
SERVICE_ACCOUNT_PATH=credentials/service_account.json

# ── Proxy (فقط اگه سرورت به Telegram دسترسی نداره) ────────────
# PROXY_URL=socks5://user:pass@1.2.3.4:1080
# PROXY_URL=http://user:pass@1.2.3.4:3128

# ── Bot behaviour ──────────────────────────────────────────────
# Max simultaneous downloads per user
MAX_CONCURRENT_PER_USER=3
